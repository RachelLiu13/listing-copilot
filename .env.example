# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # server only: bypasses Row Level Security

# Claude API → platform.claude.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5                            # optional

# Stripe (TEST mode) → Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: show "Continue with Google" (enable the Google provider in Supabase first)
NEXT_PUBLIC_GOOGLE_AUTH=off
